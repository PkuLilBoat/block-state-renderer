{
	"name": "block-state-renderer",
	"version": "0.1.0",
	"private": true,
	"description": "Editable Live Preview for task and PRD block states",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "node --experimental-strip-types --test tests/*.test.mjs"
	},
	"license": "0BSD",
	"overrides": { "fast-uri": "3.1.6" },
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "9.39.4",
		"@types/node": "22.19.17",
		"esbuild": "0.25.5",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.4.0",
		"globals": "17.6.0",
		"jiti": "2.7.0",
		"obsidian": "1.13.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.59.2"
	}
}
